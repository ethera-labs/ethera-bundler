# ethera-bundler - example environment file.
# Copy to `.env` and fill in the required values.
# Every setting is also available as a CLI flag (see `ethera-bundler --help`).

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Chain ID the bundler signs for. Must match the chain reachable at EXEC_RPC_URL.
ETHERA_BUNDLER_CHAIN_ID=

# Execution-layer JSON-RPC endpoint (op-rbuilder, op-reth, geth, …).
# Used for eth_call, eth_estimateGas, eth_getTransactionCount, baseFee, etc.
ETHERA_BUNDLER_EXEC_RPC_URL=http://127.0.0.1:8545

# Sequencer EOA private key (32-byte hex, with or without `0x`).
# This key signs the outer handleOps transaction and receives the EntryPoint
# reimbursement as `beneficiary`.
ETHERA_BUNDLER_SEQUENCER_KEY=

# EntryPointSimulations runtime bytecode (hex, with or without `0x`).
# Used as the `code` field of an eth_call state override so we can invoke
# `simulateValidation` against the live EntryPoint without redeploying it.
# Build it from eth-infinitism/account-abstraction v0.7.0:
#   forge inspect contracts/core/EntryPointSimulations.sol:EntryPointSimulations deployedBytecode
ETHERA_BUNDLER_ENTRYPOINT_SIMULATIONS_CODE=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# JSON-RPC server bind address. Default: 0.0.0.0:8082
# ETHERA_BUNDLER_LISTEN_ADDR=0.0.0.0:8082

# EntryPoint contract address. Default: canonical ERC-4337 v0.7
# (0x0000000071727De22E5E9d8BAf0edAc6f37da032).
# ETHERA_BUNDLER_ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# Maximum UserOperations per request. Default: 10
# ETHERA_BUNDLER_MAX_BATCH_SIZE=10

# Minimum maxPriorityFeePerGas the bundler will accept on a UserOperation, in wei.
# Default: 1_000_000_000 (1 gwei). Userops below this are rejected with -32602.
# ETHERA_BUNDLER_MIN_PRIORITY_FEE_WEI=1000000000

# Safety margin added on top of eth_estimateGas for handleOps, in percent.
# Default: 10
# ETHERA_BUNDLER_GAS_MARGIN_PCT=10

# Tracing filter. Standard tracing-subscriber syntax.
# Default: info
# RUST_LOG=ethera_bundler=debug,jsonrpsee=info,info
